---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Project {
  name: string;
  url: string;
  description: string;
  stack: string;
  date: string;
}

const projects: Project[] = [
  {
    name: "Artham",
    url: "https://github.com/EldhoseGeorge/Artham",
    description:
      "Artham is a Chrome extension for an English-Malayalam popup dictionary. Contributed to refining its functionality and improving the overall experience.",
    stack: "TypeScript, HTML, CSS",
    date: "Aug 2026",
  },
];
---

<BaseLayout
  title="Projects — Dibin Jose"
  description="Open source projects and tools by Dibin Jose."
>
  <h1>Projects</h1>
  <p>Things I've built, mostly for learning and occasionally for usefulness.</p>

  <ul class="project-list">
    {
      projects.map((project) => (
        <li class="project-item">
          <div class="project-name">
            <a href={project.url} target="_blank" rel="noopener noreferrer">
              {project.name}
            </a>
          </div>
          <div class="project-desc">{project.description}</div>
          <div class="project-meta">
            <div class="project-stack">{project.stack}</div>
            <div class="project-date">{project.date}</div>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
