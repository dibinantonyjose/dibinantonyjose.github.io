---
import { getCollection } from "astro:content";
import PostList from "../../../components/PostList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blogs");
  const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  return allTags.map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: {
      tag,
      posts: allPosts
        .filter((post) =>
          post.data.tags
            .map((t) => t.toLowerCase())
            .includes(tag.toLowerCase()),
        )
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
const allPosts = await getCollection("blogs");
const tags = ["All", ...new Set(allPosts.flatMap((post) => post.data.tags))];
---

<BaseLayout
  title={`${tag} — Blog — Dibin Jose`}
  description={`Blog posts tagged "${tag}".`}
>
  <h1>Blog</h1>

  <nav class="tag-filter" aria-label="Filter by tag">
    {
      tags.map((t) => (
        <a
          href={t === "All" ? "/blogs" : `/blogs/tag/${t.toLowerCase()}`}
          class:list={[{ active: t.toLowerCase() === tag.toLowerCase() }]}
        >
          {t}
        </a>
      ))
    }
  </nav>

  {
    posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p>No posts found with this tag.</p>
    )
  }
</BaseLayout>
